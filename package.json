{
  "name": "math-learning-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "demo": "node src/demo.ts",
    "dev": "vite --configLoader native --host 127.0.0.1 --port 5173 --strictPort",
    "bank:generate": "node scripts/build-qfn-bank.ts",
    "bank:check": "node scripts/build-qfn-bank.ts --check",
    "build": "node scripts/build-qfn-bank.ts --check && tsc --noEmit && vite build --configLoader native",
    "build:demo": "node scripts/build-qfn-bank.ts --check && tsc --noEmit && vite build --configLoader native --mode demo",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --port 4173 --strictPort",
    "prepare:answers": "node scripts/prepare-answers.ts",
    "verify:prepared": "node scripts/evaluate-answers.ts",
    "verify:live": "node scripts/evaluate-answers.ts --live",
    "build:pages": "node scripts/build-qfn-bank.ts --check && tsc --noEmit && vite build --configLoader native --base=/math-learning-app/"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  },
  "dependencies": {
    "sharp": "0.34.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  }
}
